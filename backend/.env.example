# Copy this file to ".env" (same folder) and fill in what you have. Lines starting with # are ignored.
# The .env file is never uploaded to GitHub.

# AI clip picking (optional — without it a simpler built-in method picks clips)
ANTHROPIC_API_KEY=

# Free stock b-roll (one is enough)
PIXABAY_API_KEY=
PEXELS_API_KEY=

# Speech model: tiny / base / small / medium / large-v3 (bigger = more accurate, slower)
WHISPER_MODEL=small
